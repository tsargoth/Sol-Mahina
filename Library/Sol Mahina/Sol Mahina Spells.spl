    {
      "id": "p5Qg0nfZ5KzCUE0CW",
      "name": "Create Chimera",
      "reference": "SexAndPreg:77",
      "reference_highlight": "Create Chimera",
      "tags": [
        "Sexual Magic"
      ],
      "difficulty": "iq/vh",
      "power_source": "Arcane",
      "spell_class": "Regular",
      "casting_cost": "20 per embryo in the fusion",
      "local_notes": "Fuses two or more very early embryos of different species into one viable organism. The subject may be a live host or growth tank. For a live host, at least one embryo must be the host species; implanted embryos may be placed surgically or with Transfer Pregnancy. Skill modifiers: 0 very close cross; -3 closely related; -6 distant; -8 radical; +4 to duplicate a previous success with the same mix; -4 for three species, -8 for four, -12 for five, etc. Success forms a viable chimera; normally add 1d points of disadvantages per 3 points of advantages gained. Critical success reduces this to 1 point of disadvantages per full 15 points of advantages. Failure by 1 may leave separate viable embryos instead of a fusion; critical failure may produce severe deformity and/or danger to the mother. A successful spell also ensures the embryo can be carried safely to term and generally sizes the fetus appropriately to the host.",
      "prereqs": {
        "type": "prereq_list",
        "all": true,
        "prereqs": [
